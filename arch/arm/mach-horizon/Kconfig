if ARCH_HORIZON

config TARGET_X5
	bool "Horizon X5 SOC"
	help
	  Support for the Horizon X5 SoC.

config DROBOT_DISABLE_WDT
	bool "Drobot disable watchdog"
	depends on WDT
	help
	  Support disable watchdog in drobotic X5 SOC.

config DROBOT_OPTEE_RPMB_DEBUG_CMD
	bool "enable x5  rpmb optee cmd 'x5_rpmb'"
	help
	  Support debug optee rpmb witch cmd x5_rpmb.

config DROBOT_BOOT_KEY_IN_RPMB
	bool "boot key is in rpmb"
	help
	  Support save boot key in rpmb in drobotic X5 SOC.

config DROBOT_RECORD_UBOOT_RESET
	bool "record uboot reset reason"
	default y
	help
	  Support save boot key in rpmb in drobotic X5 SOC.

config HOBOT_TEST_IN_SRAM
	bool "Enable SRAM test"
	depends on TARGET_X5
	help
	  Enable SRAM memory test during DRAM initialization.
	  This will copy a test binary into SRAM and execute it
	  to verify DDR functionality.

source "arch/arm/mach-horizon/x5/Kconfig"

endif
